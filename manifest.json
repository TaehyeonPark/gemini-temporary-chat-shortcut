{
    "manifest_version": 3,
    "name": "Gemini Temporary Chat Shortcut",
    "description": "Open Gemini temporary chat instantly with Option+Shift+G (macOS) / Alt+Shift+G (Windows/Linux). Rebindable from chrome://extensions/shortcuts. No data collected.",
    "homepage_url": "https://github.com/TaehyeonPark/gemini-temporary-chat-shortcut",
    "version": "1.0.1",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://gemini.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_title": "Gemini Temporary Chat Shortcut — click to change shortcut"
    },
    "background": {
        "service_worker": "background.js"
    },
    "commands": {
        "activate-temp-chat": {
            "suggested_key": {
                "default": "Alt+Shift+G"
            },
            "description": "Open Gemini temporary chat"
        }
    }
}